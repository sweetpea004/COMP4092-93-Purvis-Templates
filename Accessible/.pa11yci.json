{
  "defaults": {
    "standard": "WCAG2AA",
    "timeout": 30000,
    "wait": 500,
    "viewport": {
      "width": 1280,
      "height": 800
    },
    "chromeLaunchConfig": {
      "args": ["--no-sandbox"]
    }
  },
  "urls": [
    {
      "url": "http://localhost:5173/",
      "runners": ["axe", "htmlcs"],
      "actions": ["wait for element #meals to be visible"]
    },
    {
      "url": "http://localhost:5173/?cart-open",
      "runners": ["axe", "htmlcs"],
      "actions": [
        "wait for element #meals to be visible",
        "click element #cart-toggle",
        "wait for element dialog.modal[open] to be visible"
      ]
    },
    {
      "url": "http://localhost:5173/?checkout-open",
      "runners": ["axe", "htmlcs"],
      "actions": [
        "wait for element #meals to be visible",
        "click element .meal-item:first-of-type .meal-item-actions button",
        "click element #cart-toggle",
        "wait for element dialog.modal[open] to be visible",
        "click element #go-to-checkout",
        "wait for element #checkout-title to be visible"
      ]
    },
    {
      "url": "http://localhost:5173/?wcag22",
      "runners": ["axe"],
      "rules": ["target-size"],
      "actions": ["wait for element #meals to be visible"]
    }
  ]
}
