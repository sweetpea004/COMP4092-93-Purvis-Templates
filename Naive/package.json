{
  "name": "food-order",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "backend": "npm --prefix backend start",
    "dev:a11y": "vite --port 5173 --strictPort",
    "pa11y": "pa11y-ci",
    "test:a11y": "start-server-and-test backend http://localhost:3000/meals dev:a11y http://localhost:5173 pa11y",
    "axe": "node scripts/axe.mjs",
    "axe:json": "node scripts/axe.mjs --json",
    "test:axe": "start-server-and-test backend http://localhost:3000/meals dev:a11y http://localhost:5173 axe"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.13.0",
    "@axe-core/react": "^4.13.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "axe-core": "^4.13.0",
    "eslint": "^8.45.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "pa11y": "^10.0.0",
    "pa11y-ci": "^4.1.1",
    "puppeteer": "^25.11.0",
    "start-server-and-test": "^3.0.12",
    "vite": "^7.2.7"
  }
}
